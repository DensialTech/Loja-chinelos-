# Supabase (browser/client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL used for redirects, metadata and checkout callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets: never expose these as NEXT_PUBLIC_* variables
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_REGION=

# Payment provider (configure only after selecting the Brazilian gateway)
PAYMENT_PROVIDER=
PAYMENT_ACCESS_TOKEN=
PAYMENT_WEBHOOK_SECRET=
